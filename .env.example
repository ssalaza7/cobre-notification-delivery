# Plantilla de variables de entorno. Copiar a `.env`, que NO se versiona.
#
#   cp .env.example .env
#   # genera un secreto propio y pegalo abajo:
#   openssl rand -base64 48
#
#   set -a; source .env; set +a
#
# Este archivo es una plantilla: no contiene ningun secreto real y por eso si se
# versiona. El `.env` con los valores reales esta en .gitignore.

# ---------------------------------------------------------------------------
# SECRETO. Obligatorio: la aplicacion no arranca sin el.
# ---------------------------------------------------------------------------
# Clave HS256 con la que se firman y validan los tokens. Minimo 32 bytes.
#
# No tiene valor por defecto a proposito. Un secreto escrito en el codigo queda en
# el historial de git para siempre —aunque despues se borre— y se filtra a cualquiera
# que clone el repositorio.
#
# En AWS se inyecta desde Secrets Manager, que permite rotarlo sin redesplegar y deja
# registro de cada acceso en CloudTrail.

# ---------------------------------------------------------------------------
# Credenciales de los contenedores locales.
# ---------------------------------------------------------------------------
# Estos valores por defecto corresponden a los contenedores desechables que levanta
# docker-compose y no dan acceso a nada fuera de tu maquina. Se listan para que se vea
# que son configurables; en cualquier entorno real vienen del gestor de secretos.
# DynamoDB guarda las notificaciones y su bitacora de intentos. En local, DynamoDB Local.
# En AWS se deja DYNAMODB_ENDPOINT vacio y las credenciales las da el rol de la tarea.
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_TABLE=notifications
DYNAMODB_SUBSCRIPTIONS_TABLE=subscriptions
# Cuanto se conserva cada intento antes de que DynamoDB lo expire. El estado final del
# evento no caduca.
DYNAMODB_ATTEMPT_TTL=90d

# Kafka: bus de eventos de la plataforma. En local, Redpanda.
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=cobre.platform.events

# SQS: cola de trabajo de las entregas. En local, ElasticMQ.
# En AWS se deja SQS_ENDPOINT vacio y las credenciales las da el rol de la tarea.
SQS_ENDPOINT=http://localhost:9324
AWS_REGION=us-east-1

# Proveedor de identidad. Emite los tokens y publica las claves con las que la API
# verifica su firma. En local lo levanta docker compose (Keycloak); en AWS son las tres
# direcciones del grupo de usuarios de Cognito.
OIDC_ISSUER_URI=http://localhost:8087/realms/cobre
OIDC_JWK_SET_URI=http://localhost:8087/realms/cobre/protocol/openid-connect/certs
OIDC_TOKEN_URI=http://localhost:8087/realms/cobre/protocol/openid-connect/token

# ---------------------------------------------------------------------------
# Opcionales
# ---------------------------------------------------------------------------
# Sustituye el destino de todas las suscripciones. Para la demostracion en vivo,
# donde la URL se entrega el mismo dia.
WEBHOOK_OVERRIDE_URL=

# Puerto del modulo que se arranca. Por defecto: 8080 la API, 8081 el worker,
# 8083 el consumidor.
SERVER_PORT=

# Exportacion de metricas a Datadog. Apagada por defecto: cada combinacion de
# etiquetas es una serie facturable.
COBRE_DATADOG_ENABLED=false
DATADOG_API_KEY=
